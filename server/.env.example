# Copy to server/.env and fill in. NEVER commit the filled version.

# --- MongoDB Atlas -------------------------------------------------------
# Atlas > Connect > Drivers. Remember to allowlist 0.0.0.0/0 for the event.
MONGODB_URI=

# --- Google Gemini -------------------------------------------------------
GEMINI_API_KEY=
# Leave blank to use the current default. Retired ids are detected and replaced.
GEMINI_MODEL=
# Set true to serve canned fixtures instead of calling the API.
# Keeps the build testable offline and saves the demo if Wi-Fi dies.
GEMINI_MOCK=false

# --- Cloudinary ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Internal services ---------------------------------------------------
ML_SVC_URL=http://localhost:8000
ML_SVC_TIMEOUT_MS=2500
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
